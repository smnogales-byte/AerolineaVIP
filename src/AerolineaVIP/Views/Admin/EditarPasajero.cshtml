@using Progra_03.Models;
@model EditarPasajeroVM
@{
    ViewBag.Title = "Editar pasajero";
}
<h1 class="h3 titulo-pantalla">Editar pasajero</h1>
<p class="subtitulo-pantalla">Documento: @Model.TipoDocumentoCodigo @Model.NumeroDocumento (no se puede modificar)</p>

<div class="row">
    <div class="col-lg-6">
        <div class="panel-vip">
            @using (Html.BeginForm("EditarPasajero", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.PasajeroId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
                <div class="mb-3">
                    @Html.LabelFor(m => m.Nombres, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", maxlength = 100 })
                    @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.Apellidos, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", maxlength = 100 })
                    @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.FechaNacimiento, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", maxlength = 256 })
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.Telefono, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", maxlength = 20 })
                    @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-vip">Guardar cambios</button>
                    <a class="btn btn-outline-secondary" href="@Url.Action("Gestion", new { pestana = "pasajeros" })">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }
